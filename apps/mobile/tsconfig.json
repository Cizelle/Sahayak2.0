{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"lib": ["ES2023", "DOM"],
		"types": ["react", "react-native"]
	},
	"include": ["index.js", "App.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
